{
  "rules": {
    ".write": "auth != null && auth.token.email_verified == true && (auth.token.email == 'kundar.work@gmail.com' || auth.token.email == 'kundar701@gmail.com')",
    "catbox_gdrive_folders": {
      ".read": true,
      "$item": {
        ".write": "auth != null && auth.token.firebase.sign_in_provider == 'anonymous' && !data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['name','parentId','timestamp']) && newData.child('name').isString() && newData.child('name').val().length <= 120 && newData.child('parentId').isString() && newData.child('timestamp').isNumber()"
      }
    },
    "catbox_gdrive_files": {
      ".read": true,
      "$item": {
        ".write": "auth != null && auth.token.firebase.sign_in_provider == 'anonymous' && !data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['fileId','name','parentId','size','timestamp']) && newData.child('fileId').isString() && newData.child('fileId').val().length <= 2048 && newData.child('name').isString() && newData.child('name').val().length <= 200 && newData.child('parentId').isString() && newData.child('size').isNumber() && newData.child('size').val() >= 0 && newData.child('size').val() <= 104857600 && newData.child('timestamp').isNumber()"
      }
    },
    "apml_ranked_gallery": {
      ".read": true,
      "$item": {
        ".write": "auth != null && auth.token.firebase.sign_in_provider == 'anonymous' && !data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['url','folder','name','size','isVideo','viewsCount','downloadsCount','timestamp']) && newData.child('url').isString() && newData.child('url').val().length <= 2048 && newData.child('folder').isString() && newData.child('name').isString() && newData.child('name').val().length <= 200 && newData.child('size').isNumber() && newData.child('size').val() >= 0 && newData.child('size').val() <= 104857600 && newData.child('isVideo').isBoolean() && newData.child('viewsCount').isNumber() && newData.child('downloadsCount').isNumber() && newData.child('timestamp').isNumber()"
      }
    },
    "directory": {
      ".read": true,
      ".write": "auth != null && auth.token.email_verified == true && (auth.token.email == 'kundar.work@gmail.com' || auth.token.email == 'kundar701@gmail.com')"
    },
    "field_officers": {
      ".read": true,
      ".write": "auth != null && auth.token.email_verified == true && (auth.token.email == 'kundar.work@gmail.com' || auth.token.email == 'kundar701@gmail.com')"
    },
    "arcade_scores": {
      ".indexOn": [
        "score"
      ]
    },
    "analytics": {
      "daily_logs": {
        ".read": true,
        "$date": {
          "$counter": {
            ".write": "auth != null && ((($counter == 'visitors' || $counter == 'pdf' || $counter == 'media') && auth.token.firebase.sign_in_provider == 'anonymous') || (auth.token.email_verified == true && (auth.token.email == 'kundar.work@gmail.com' || auth.token.email == 'kundar701@gmail.com')))",
            ".validate": "newData.isNumber() && (data.exists() ? newData.val() == data.val() + 1 : newData.val() == 1)"
          }
        }
      },
      "totalPdfDownloads": {
        ".read": true
      },
      "totalMediaDownloads": {
        ".read": true
      },
      "visitor_sessions": {
        ".read": "auth != null && auth.token.email_verified == true && (auth.token.email == 'kundar.work@gmail.com' || auth.token.email == 'kundar701@gmail.com')",
        "$sessionKey": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider == 'anonymous' && ((data.exists() && data.child('uid').val() == auth.uid && (!newData.exists() || newData.child('uid').val() == auth.uid)) || (!data.exists() && newData.child('uid').val() == auth.uid))",
          ".validate": "newData.hasChildren(['uid', 'visitorId', 'startedAt', 'lastSeen', 'device', 'os', 'browser', 'pageViews', 'totalSeconds', 'pages', 'journey']) && newData.child('pageViews').isNumber() && newData.child('pageViews').val() <= 10000 && newData.child('totalSeconds').isNumber() && newData.child('totalSeconds').val() <= 86400"
        }
      }
    },
    "presence": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.token.firebase.sign_in_provider == 'anonymous' && auth.uid == $uid"
      }
    },
    ".read": "auth != null && auth.token.email_verified == true && (auth.token.email == 'kundar.work@gmail.com' || auth.token.email == 'kundar701@gmail.com')"
  }
}
